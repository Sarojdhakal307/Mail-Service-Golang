# Server configuration for running the published image with docker-compose.yml.
#   cp .env.example .env
# Fill in every empty value below. Never commit or share .env: it holds your secrets.

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# Image tag to run. Pin a release (e.g. 1.2.3) in production so updates are deliberate.
MAILSERVICE_VERSION=latest

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080

# Address the port is published on. 127.0.0.1 = only a reverse proxy on this host can
# reach it. Use 0.0.0.0 to expose it directly (then set TRUST_PROXY and COOKIE_SECURE to false).
BIND_ADDR=127.0.0.1

# true: client IPs are read from X-Forwarded-For. Only safe behind your own reverse proxy.
TRUST_PROXY=true

# true: the admin login cookie is sent only over HTTPS. Requires HTTPS in front of the service.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# docker-compose builds DATABASE_URL from these values automatically.
# Use only letters and digits in the password. Generate one with:
#   openssl rand -hex 24
POSTGRES_USER=mailservice
POSTGRES_PASSWORD=
POSTGRES_DB=mailservice

# ---------------------------------------------------------------------------
# Super user (admin UI at https://<your-domain>/admin/)
# ---------------------------------------------------------------------------
# The password must be at least 12 characters. The service will not start without it.
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=

# ---------------------------------------------------------------------------
# Super API key: no limits, any IP (optional)
# ---------------------------------------------------------------------------
# At least 32 characters. Generate with:  openssl rand -hex 32
# Leave empty to disable.
SUPER_API_KEY=

# ---------------------------------------------------------------------------
# API key encryption (REQUIRED)
# ---------------------------------------------------------------------------
# 64 hex characters. Generate with:  openssl rand -hex 32
# Never change or lose it, or stored keys can no longer be revealed.
API_KEY_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Default SMTP server. Leave SMTP_HOST empty to only log mails (simulation mode).
# Port 465 uses implicit TLS; other ports use STARTTLS.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
