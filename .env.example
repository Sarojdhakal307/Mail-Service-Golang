# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env — it is already listed in .gitignore.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080

# Set to true only when running behind a reverse proxy you control, so the client IP
# is read from X-Forwarded-For. Otherwise clients could spoof it to bypass IP rules.
TRUST_PROXY=false

# Set to true when the admin UI is served over HTTPS (recommended in production).
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# PostgreSQL (REQUIRED)
# ---------------------------------------------------------------------------
# Used by docker-compose to create the database container.
# Use only letters and digits in the password, or URL-encode it in DATABASE_URL.
POSTGRES_USER=mailservice
POSTGRES_PASSWORD=
POSTGRES_DB=mailservice

# Connection string for `go run .` on your machine. docker-compose overrides this
# automatically to point at the postgres container.
DATABASE_URL=postgres://mailservice:<POSTGRES_PASSWORD>@localhost:5432/mailservice?sslmode=disable

# ---------------------------------------------------------------------------
# Super user (REQUIRED) — signs in to the admin UI at http://localhost:8080/admin/
# ---------------------------------------------------------------------------
# The password must be at least 12 characters. The service will not start without it.
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=

# ---------------------------------------------------------------------------
# Super API key (optional)
# ---------------------------------------------------------------------------
# A key with no rate limits and no IP restriction. Registered in the database on startup.
# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
# Leave empty to disable. Changing or clearing it disables the previous key on the next start.
# You can also create super keys from the admin UI.
SUPER_API_KEY=

# ---------------------------------------------------------------------------
# API key encryption (REQUIRED)
# ---------------------------------------------------------------------------
# Encrypts stored API keys (AES-256-GCM) so the super user can copy them again later
# from the admin UI. 64 hex characters. Generate with:
#   openssl rand -hex 32
# Keep it safe and never change it: if it is lost or changed, existing keys keep working
# but can no longer be revealed.
API_KEY_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# SMTP (optional)
# ---------------------------------------------------------------------------
# If SMTP_HOST, SMTP_PORT or SMTP_FROM is empty, mails are only logged (simulation mode).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-user@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=no-reply@example.com
